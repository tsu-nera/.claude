#!/usr/bin/env bash
# Run unattended Claude jobs on the home workers as background sessions (claude --bg) with Remote Control on,
# so they survive the laptop going offline and can be answered from the phone / claude.ai/code when they get stuck.
# Per repo, work comes from prompts queued with `add` first, then open issues labeled autopilot (urgent first).
# Labeled issues always run as /issue-to-merge; one that needs a human before merge is queued as a "/issue-to-pr <n>" prompt instead.
# The queue and loops live on vaio (always on); each job goes to the first worker in workers.conf with room, woken if asleep.
#   autopilot ls                                     running jobs and what runs next, per repo
#   autopilot add <repo> <issue#> [--urgent]         label the issue autopilot (and urgent)
#   autopilot add <repo> <prompt>                    queue a free prompt, e.g. "/task-to-merge ..."
#   autopilot rm <repo> <issue#|prompt-id>           unlabel the issue / drop the queued prompt
#   autopilot start <repo|all> [--urgent] [--until HH:MM] [--5h-max PCT] [--model sonnet]
#                                                    work through the repo's queue in tmux, one job at a time
#   autopilot stop <repo|all>                        stop launching more (running sessions keep going)
#   autopilot pause <repo|all> / resume <repo|all>   hold / release new launches; the loop and its running job stay
#   autopilot watch <repo>                           block until a job is blocked / needs an answer / failed or the loop ends
#   autopilot projects                               defined projects and whether each is ready on each worker
#   autopilot status                                 background sessions with state and Remote Control URL, per worker
#   autopilot clean                                  stop idle sessions (they keep ~300MB each until stopped)
#   autopilot res                                    load / memory / agent count, per worker
set -uo pipefail

# The controller: where the queue, loops and notifications live. Run off it, autopilot forwards itself there over ssh,
# except the _w-* commands, which the controller runs on the worker it picked.
HOST=vaio
WATCH_POLL=${AUTOPILOT_WATCH_POLL:-30}
source "$(dirname "$(realpath "$0")")/lib/autopilot-notify.sh"

if [[ "$(hostname)" != ${HOST}* && ${1:-} != _w-* ]]; then
  if [[ ${1:-} == watch ]]; then shift; cmd_watch "$@"; exit; fi
  tty=(); [[ -t 0 ]] && tty=(-t)
  exec ssh "${tty[@]}" "$HOST" "bash -lc $(printf %q "$(printf '%q ' autopilot "$@")")"
fi

# Per-worker room (max busy sessions, min free memory) is in workers.conf. Agents themselves are light (~300MB, ~5% CPU);
# the heavy part is tsc (peak 1.8GB) and vitest (all cores), which repos serialize with their own lock
# (xchain-arb: prepush-checks.lock). So a worker fits one more agent while it has room for one more tsc peak.
WORKERS_CONF=$HOME/.claude/skills/autopilot/workers.conf
# A worker that could not be reached or woken is skipped for this long, so each launch doesn't wait on it again.
DOWN_MINUTES=10
WAKE_WAIT=90
# A job that goes idle sooner than this, or not in state done, most likely hit the 5-hour limit or an error.
# Launching the next one would hit the same wall, so the loop halts instead of burning through the queue.
MIN_JOB_SECONDS=180
# A job that ends on an API error (outage, overload) is queued again after these waits, one per consecutive failure across
# the loop: an outage hits every job alike. One more failure past the list halts the loop.
API_RETRY_WAITS=(600 1800)
# A session that finished its turn (state done) but stays busy this long is held by a hung child, such as an RPC call
# without a timeout. Waiting on it would hold the loop forever, so it is stopped and judged as done.
DONE_BUSY_GRACE=600
# How long a job that needs someone waits for a watcher to pick it up before it goes to #hitl (a watch polls every 30s).
ACK_WAIT=${AUTOPILOT_ACK_WAIT:-120}
# Usage written by statusline-command.sh, which also renders inside the worker's background sessions.
# At the 5-hour cap the loop waits for the reset; at the weekly cap it stops, since that reset is days out.
# The weekly cap is the real limit on purpose: unused weekly quota is lost at the reset.
LIMITS_FILE=${AUTOPILOT_LIMITS_FILE:-$HOME/.cache/claude-rate-limits.json}
# Discord webhook for job start/finish only (one line each). Kept out of git: anyone holding the URL can post.
WEBHOOK_FILE=$HOME/.config/autopilot/discord-webhook
MODEL=""          # empty: settings.json default; `start --model` overrides per loop
FIVE_HOUR_MAX=90  # default; `start --5h-max` lowers it to leave room for interactive use in the same window
SEVEN_DAY_MAX=98
PROJECTS_CONF=$HOME/.claude/skills/autopilot/projects.conf
STATE=$HOME/.local/state/autopilot
SELF=$(realpath "$0")

# Appended to the system prompt rather than the prompt, which must stay a bare /skill invocation.
# Which operations are dangerous differs per repo, so this only states that nobody is watching and defers to the repo's rules.
WORKER_NOTE='このセッションは無人の worker で、確認できる人はいない。取り消せない操作や repo の外に影響が残る操作は、repo の規約で人の確認が要るとされているものも含めて、実行せず手前で止めて報告する。PR の作成と push は対象外（実行してよい）。
外部イベント（他人の tx・定期 job など）の到来を待つ検証は10分で打ち切り、PR 本文の「未実施」に理由と後で確かめる手順を書いて先へ進む。
設計の不足や Issue の前提の誤りが見つかっても止まらない。/issue-to-merge の「AC 改訂」に従い、決定を Issue 本文の「## 追加決定」に書いてから merge まで進める。
人の判断が要る時（SPLIT_NEEDED・merge-gate が要人間・上の取り消せない操作が要る・要件が読めない）も入力待ちで止まらない。PR は残し、Issue に選択肢と推奨を添えて質問をコメントし、`gh issue edit <番号> --add-label needs-answer --remove-label autopilot --remove-label urgent` を実行して終了する。朝まで答える人はいない。人が Issue のコメントで答えて `autopilot add` で積み直すと、既存の PR から再開される。'
WORKER_SETTINGS='{"autoMemoryEnabled": false, "hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "~/.claude/hooks/deny-unguarded-rm-var.sh"}]}]}}'

die() { echo "autopilot: $*" >&2; exit 1; }
# Issue state plus issue and linked PR URLs, one per line. URLs are wrapped in <> so Discord doesn't unfurl them.
issue_outcome() {
  (cd "$1" && gh issue view "$2" --json url,state,closedByPullRequestsReferences \
    -q '"issue \(.state) <\(.url)>" + ([.closedByPullRequestsReferences[] | "\nPR #\(.number) <\(.url)>"] | join(""))')
}
issue_has_label() {
  [[ "$(cd "$1" && gh issue view "$2" --json labels -q "[.labels[].name] | index(\"$3\") != null")" == true ]]
}
issue_has_decision() {
  (cd "$1" && gh issue view "$2" --json body -q .body) | grep -q '^## 追加決定'
}
issue_url() { (cd "$1" && gh issue view "$2" --json url -q .url); }
issue_closed_by_pr() {
  [[ "$(cd "$1" && gh issue view "$2" --json state,closedByPullRequestsReferences \
    -q '.state == "CLOSED" and (.closedByPullRequestsReferences | length > 0)')" == true ]]
}
# Issue number a job works on: the issue itself, or the one named in a queued "/issue-to-merge 3995 ..." prompt.
job_issue() { if [[ $1 == issue ]]; then echo "$2"; else grep -oP '/issue-to-(merge|pr)\s+#?\K[0-9]+' <<<"$3" | head -1; fi; }
now() { date +%H:%M; }
# Seconds to wait before relaunching after the given API error kind and count of them in a row; nothing means halt.
# Only an outage passes with time; any other kind (model_not_found, ...) fails the same way on every retry.
api_retry_wait() {
  [[ $1 =~ ^(server_error|overloaded|rate_limit|unknown) ]] && (( $2 <= ${#API_RETRY_WAITS[@]} )) && echo "${API_RETRY_WAITS[$2 - 1]}"
}
# Put a launched job back in the queue as `add` would, minus the labels it still carries. Uses $st from the loop.
requeue() {
  if [[ $1 == prompt ]]; then mv "$st/done/$2.prompt" "$st/queue/"
  else sed -i "/^$2\$/d" "$st/taken"; echo "$2" >>"$st/resume"; fi
}
project_names() { grep -v '^\s*#' "$PROJECTS_CONF" | awk 'NF {print $1}'; }
project_path() { local p; p=$(awk -v n="$1" '$1 == n {print $2}' "$PROJECTS_CONF"); echo "${p/#\~/$HOME}"; }
repo_dir() {
  local d; d=$(project_path "${1##*/}")
  [[ -n $d ]] || die "unknown project ${1##*/} (define it in $PROJECTS_CONF)"
  [[ -d $d/.git ]] || die "no clone at $d"
  echo "$d"
}
repo_state() { local s=$STATE/${1##*/}; mkdir -p "$s/queue"; echo "$s"; }
worker_names() { grep -v '^\s*#' "$WORKERS_CONF" | awk 'NF {print $1}'; }
worker_field() { awk -v n="$1" -v i="$2" '$1 == n {print $i}' "$WORKERS_CONF"; }
# Runs an autopilot command on a worker: in place on the controller, else over ssh. The command goes in on stdin so the
# login shell there (fish on mouse) never parses bash quoting. Exit 255 means the worker could not be reached.
on_worker() {
  local w=$1; shift
  if [[ $w == "$HOST" ]]; then "$SELF" "$@"; return; fi
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$w" 'bash -ls' <<<"~/.claude/bin/autopilot $(printf '%q ' "$@")"
}
# Fails when the worker can't be reached, so callers can tell that from "no sessions".
agents() { on_worker "$1" _w-agents; }
busy_count() { local j; j=$(agents "$1") || return 1; jq '[.[] | select(.status == "busy")] | length' <<<"$j"; }
attach_hint() { if [[ $1 == "$HOST" ]]; then echo "claude attach $2"; else echo "ssh $1, claude attach $2"; fi; }
recently_down() { [[ -n $(find "$STATE/down-$1" -mmin -"$DOWN_MINUTES" 2>/dev/null) ]]; }
# Succeeds when the worker answers, waking it first if asleep. One the loop woke is marked, so it goes back to sleep
# once nothing of autopilot's is left there (sleep_idle_workers); one that was already awake is left as it was.
worker_up() {
  local w=$1 wake
  [[ $w == "$HOST" ]] && return 0
  recently_down "$w" && return 1
  on_worker "$w" _w-mem >/dev/null 2>&1 && return 0
  wake=$(worker_field "$w" 4)
  if [[ -n $wake && $wake != - ]]; then
    echo "$(now) $w unreachable, waking it ($wake)" >&2
    "$wake" >&2
    local t0=$SECONDS
    while (( SECONDS - t0 < WAKE_WAIT )); do
      if on_worker "$w" _w-mem >/dev/null 2>&1; then touch "$STATE/woke-$w"; echo "$(now) $w is up" >&2; return 0; fi
      sleep 5
    done
  fi
  echo "$(now) $w unreachable, skipping it for ${DOWN_MINUTES}m" >&2
  touch "$STATE/down-$w"
  return 1
}
# A worker the loop woke goes back to sleep when no session is alive there (a blocked one waits for its answer; an entry
# without status has no process left) and no other loop, which could launch there next, is running.
# Arg: the calling loop's own repo, which is ending.
sleep_idle_workers() {
  local self=${1:-} w j
  tmux ls -F '#S' 2>/dev/null | grep '^autopilot-' | grep -qvx "autopilot-$self" && return 0
  for w in $(worker_names); do
    [[ -f $STATE/woke-$w ]] || continue
    j=$(agents "$w") || continue
    (( $(jq '[.[] | select(.status != null)] | length' <<<"$j") == 0 )) || continue
    on_worker "$w" _w-suspend && rm -f "$STATE/woke-$w" && echo "$(now) $w: nothing left there, suspended it"
  done
}
# Check and launch share one lock, held until the new session shows as busy, so two loops can't both pass the check
# before either session is counted. Tries the workers in workers.conf order and prints "<worker> <session id>".
# Returns 1 when no worker has room (retry later) and 2 when claude itself refused to launch (retrying would fail the
# same way), with the reason on stderr. A worker that is unreachable or lacks the project is passed over, not fatal.
try_launch() {
  local name=$1 prompt=$2 label=$3
  mkdir -p "$STATE"
  (
    flock 8
    local w busy avail id rc why=()
    for w in $(worker_names); do
      worker_up "$w" || { why+=("$w down"); continue; }
      if ! busy=$(busy_count "$w") || ! avail=$(on_worker "$w" _w-mem); then why+=("$w unreachable"); continue; fi
      if (( busy >= $(worker_field "$w" 2) || avail < $(worker_field "$w" 3) )); then
        why+=("$w busy $busy/$(worker_field "$w" 2) mem ${avail}MB"); continue
      fi
      id=$(on_worker "$w" _w-launch "$name" "$label" "$MODEL" "$prompt"); rc=$?
      case $rc in
        0) ;;
        3|255) why+=("$w not usable"); continue ;;
        *) exit 2 ;;
      esac
      for _ in $(seq 24); do (( $(busy_count "$w" || echo 0) > busy )) && break; sleep 5; done
      echo "$w $id"; exit 0
    done
    echo "$(now) no room: ${why[*]}" >&2; exit 1
  ) 8>"$STATE/launch.lock"
}

# The _w-* commands run on the worker the controller picked (on_worker).
cmd_w_ready() {
  local dir; dir=$(project_path "$1")
  [[ -d $dir/.git ]] || { echo "no clone at $dir"; return; }
  jq -e --arg p "$dir" '.projects[$p].hasTrustDialogAccepted' ~/.claude.json >/dev/null || echo "not trusted"
  gh auth status >/dev/null 2>&1 || echo "gh not logged in"
}
# Prints the session id. Exits 3 when this worker isn't set up for the project, 2 when claude refused to launch.
# The name is set explicitly: auto-generated names often drop the issue number, which is what `clean` is matched by.
cmd_w_launch() {
  local name=$1 label=$2 model=$3 prompt=$4 dir problems out id
  problems=$(cmd_w_ready "$name")
  [[ -z $problems ]] || { echo "$(now) $(hostname -s) not ready for $name: $problems" >&2; exit 3; }
  dir=$(project_path "$name")
  # The controller pulls its own checkout at start; a worker woken or left idle may be days behind on skills.
  [[ "$(hostname)" == ${HOST}* ]] || git -C ~/.claude pull --ff-only -q \
    || echo "$(now) warning: ~/.claude pull failed on $(hostname -s), skills may be stale" >&2
  git -C "$dir" pull --ff-only -q || echo "$(now) warning: pull failed in $dir, launching on the current checkout" >&2
  # Output goes through a file: the backgrounded session may inherit stdout, and a pipe would block until it exits.
  out=$(mktemp)
  local model_args=(); [[ -n $model ]] && model_args=(--model "$model")
  # Workers run on the issue and the repo rules, not on memory (about 9k tokens re-read every turn). An env var
  # would not reach the session: the bg daemon does not pass the caller's environment through, flags it keeps.
  # The hook turns prompts that bypass mode still raises into denials the agent can act on (a prompt hangs a worker).
  (cd "$dir" && claude --bg "${model_args[@]}" --settings "$WORKER_SETTINGS" \
    --name "$label" --remote-control "$label" --permission-mode bypassPermissions \
    --append-system-prompt "$WORKER_NOTE" "$prompt") >"$out" 2>&1 </dev/null
  id=$(grep -o 'backgrounded · [0-9a-f]*' "$out" | awk '{print $3}')
  [[ -n "$id" ]] || { echo "$(now) launch failed on $(hostname -s): $(cat "$out")" >&2; rm -f "$out"; exit 2; }
  rm -f "$out"
  echo "$id"
}
cmd_w_said() { local f; f=$(transcript "$1"); [[ -n $f ]] && last_said "$f"; }
cmd_w_limits() { [[ -f $LIMITS_FILE ]] && cat "$LIMITS_FILE"; }
cmd_w_status() {
  claude agents --json | jq -r --argjson now "$(date +%s)" '.[] | "\(.id)  \(.status)/\(.state // "-")  \((($now - .startedAt/1000) / 60 | floor))m  \(.name)"' \
    | while read -r id rest; do
        url=$(rc_url "$id")
        echo "$id  $rest  ${url:-}"
      done
}
cmd_w_clean() {
  claude agents --json | jq -r '[.[] | select(.kind == "background" and .status == "idle") | .id] | unique | .[]' | while read -r id; do
    claude stop "$id" >/dev/null && echo "stopped $id"
  done
}
# Asleep it can only be woken (wake command in workers.conf), so this is only sent once nothing is left there.
cmd_w_suspend() { sudo -n systemctl suspend --no-block; }

# Each worker's statusline writes what its own sessions last saw of the account's 5h and weekly windows, which every
# worker uses up alike, so the newest of them is the one to go by. A worker that is asleep is skipped, not woken.
latest_limits() {
  local w; for w in $(worker_names); do recently_down "$w" || on_worker "$w" _w-limits 2>/dev/null; done \
    | jq -s 'map(select(.updated != null)) | max_by(.updated) // empty'
}

# Prints "ok", "wait <epoch> <why>" or "halt <why>". A value past its reset time counts as reset; no file means no data yet.
usage_gate() {
  local j; j=$(latest_limits)
  [[ -n $j ]] || { echo ok; return; }
  jq -r --argjson now "$(date +%s)" --argjson h "$FIVE_HOUR_MAX" --argjson w "$SEVEN_DAY_MAX" '
    def live(x): x != null and (x.resets_at // 0) > $now;
    if live(.seven_day) and .seven_day.used_percentage >= $w then
      "halt weekly usage \(.seven_day.used_percentage | floor)% >= \($w)% (resets \(.seven_day.resets_at | strflocaltime("%a %H:%M")))"
    elif live(.five_hour) and .five_hour.used_percentage >= $h then
      "wait \(.five_hour.resets_at) 5h usage \(.five_hour.used_percentage | floor)% >= \($h)%"
    else "ok" end' <<<"$j"
}

usage_line() {
  local j; j=$(latest_limits)
  [[ -n $j ]] || { echo "usage: no data yet ($LIMITS_FILE on the workers)"; return; }
  jq -r --argjson now "$(date +%s)" '
    def pct(x): if x != null and (x.resets_at // 0) > $now then "\(x.used_percentage | floor)% (resets \(x.resets_at | strflocaltime("%a %H:%M")))" else "reset" end;
    "usage: 5h \(pct(.five_hour))  7d \(pct(.seven_day))  as of \(.updated | strflocaltime("%H:%M"))"' <<<"$j"
}

# One line per candidate in run order: "next prompt <id> <text>" / "next issue <n> <urgent|-> <title>" / "skip issue <n> <why>".
plan() {
  local name=$1 urgent_only=${2:-false} st dir f
  st=$(repo_state "$name"); dir=$(repo_dir "$name")
  for f in $(ls "$st/queue" 2>/dev/null | sort); do
    echo "next prompt ${f%.prompt} $(head -c 80 "$st/queue/$f" | tr '\n' ' ')"
  done
  (cd "$dir" && gh issue list -l autopilot --state open --limit 100 --json number,title,labels) \
    | jq -r --argjson urgent_only "$urgent_only" '
        map({n: .number, t: .title, u: ([.labels[].name] | index("urgent") != null)})
        | map(select(.u or ($urgent_only | not))) | sort_by((if .u then 0 else 1 end), .n)
        | .[] | "\(.n) \(if .u then "urgent" else "-" end) \(.t)"' \
    | while read -r n u title; do
        if grep -qx "$n" "$st/taken" 2>/dev/null; then echo "skip issue $n already launched (autopilot add to retry)"; continue; fi
        # Re-added after an answer: the PR it left behind is where /issue-to-merge resumes, not a reason to skip.
        if grep -qx "$n" "$st/resume" 2>/dev/null; then echo "next issue $n $u $title"; continue; fi
        # A linked PR means someone (a manual /issue-to-merge, an earlier loop) already took it.
        local pr; pr=$(cd "$dir" && gh issue view "$n" --json closedByPullRequestsReferences -q '[.closedByPullRequestsReferences[].number] | map("#\(.)") | join(",")')
        if [[ -n "$pr" ]]; then echo "skip issue $n linked PR $pr"; else echo "next issue $n $u $title"; fi
      done
}

# Blocks while the session is busy, then prints "<state|gone> <true|false>": the last state seen and whether it was
# stopped here. The state is the one seen before the stop, since a stopped session may drop out of `claude agents`.
# Log lines go to stderr, which the loop's log captures too.
wait_session() {
  local w=$1 id=$2 status state="" done_since="" listing unreachable=0
  while :; do
    # A worker out of reach (network blip) says nothing about the job, so keep waiting rather than read it as gone.
    if ! listing=$(agents "$w"); then
      (( unreachable++ == 0 )) && echo "$(now) $w unreachable, still waiting for $id" >&2
      sleep 60; continue
    fi
    unreachable=0
    # One listing per poll, so status and state come from the same moment.
    status=""; state=""
    read -r status state < <(jq -r --arg id "$id" '.[] | select(.id == $id) | "\(.status) \(.state // "")"' <<<"$listing")
    [[ $status == busy ]] || break
    if [[ $state != done ]]; then done_since=""
    elif [[ -z $done_since ]]; then done_since=$(date +%s)
    elif (( $(date +%s) - done_since >= DONE_BUSY_GRACE )); then
      echo "$(now) $id done but still busy for $(( ($(date +%s) - done_since) / 60 ))m (hung child process?); stopping it" >&2
      if on_worker "$w" _w-stop "$id" >/dev/null 2>&1; then echo "done true"; return; fi
      echo "$(now) could not stop $id (autopilot clean)" >&2
      break
    fi
    sleep 60
  done
  echo "${state:-gone} false"
}

# Waits for a launched job and acts on how it ended. Returns 1 when the loop must stop launching (HALTED), else 0.
# Runs inside cmd_loop: it reads dir, st and name, updates api_failures, and calls record and end_loop from there.
finish_job() {
  local kind=$1 ref=$2 id=$3 label=$4 started=$5 prompt=$6 w=$7
  local state stopped elapsed issue
  # Waiting for our own session keeps each loop to one slot, leaving the others for other repos' loops.
  read -r state stopped <<<"$(wait_session "$w" "$id")"
  # A session stopped by wait_session needs no second stop (it would only log a failure).
  stop_job() { $stopped || on_worker "$w" _w-stop "$id" >/dev/null 2>&1 || echo "$(now) could not stop $id on $w (autopilot clean)"; }
  said() { local s; s=$(on_worker "$w" _w-said "$id" | cut -f2-); echo "${s:-(transcript なし)}"; }
  elapsed=$(( $(date +%s) - started ))
  echo "$(now) $kind $ref $id on $w idle (state: $state, $((elapsed / 60))m)"
  rm -f "$st/running"
  issue=$(job_issue "$kind" "$ref" "$prompt")
  local outcome=""; [[ -n $issue ]] && outcome=$'\n'"$(issue_outcome "$dir" "$issue")"
  # A closed issue is proof of success whatever the state label says (#3820 merged, then read as "working") or however
  # short the job (#3988 merged in 3m), so it skips both checks below.
  local closed=false
  if [[ -n $issue ]] && issue_closed_by_pr "$dir" "$issue"; then closed=true; fi
  local ref_line="${label:0:80}${issue:+ <$(issue_url "$dir" "$issue")>}"
  if $closed; then
    local decided=""; issue_has_decision "$dir" "$issue" && decided=" (agent decided: see 追加決定)"
    record "merged  $ref_line$decided"
  fi
  # The worker hands a question back through the issue and exits, so the session holds nothing worth keeping.
  if ! $closed && [[ -n $issue ]] && issue_has_label "$dir" "$issue" needs-answer; then
    echo "$(now) $kind $ref needs an answer on the issue, skipping"
    record "answer  $ref_line"
    stop_job
    notify "[needs-answer] ${label:0:80}: answer on the issue, then autopilot add$outcome"
    return 0
  fi
  # An API error is written as an ordinary assistant turn, so the session reads as blocked or done like a question would.
  local api_error; api_error=$(on_worker "$w" _w-said "$id" | cut -f1)
  if ! $closed && [[ -n $api_error && $api_error != - ]]; then
    stop_job
    requeue "$kind" "$ref"
    api_failures=$(( api_failures + 1 ))
    local retry_in; retry_in=$(api_retry_wait "$api_error" "$api_failures")
    if [[ -n $retry_in ]]; then
      echo "$(now) $kind $ref hit an API error ($api_error), queued again; next launch in $((retry_in / 60))m"
      record "retry   $ref_line (API $api_error, $api_failures in a row)"
      notify "[retry] ${label:0:80}: API $api_error, queued again in $((retry_in / 60))m"
      sleep "$retry_in"
      return 0
    fi
    end_loop "HALTED: $kind $ref hit an API error ($api_error, $api_failures in a row). Queued again; not launching more."
    record "failed  $ref_line (API $api_error, $api_failures in a row)"
    notify_hitl HALTED "${label:0:80}$outcome" "API エラー（$api_error）が $api_failures 回続いたので loop は止めた。ジョブは積み直してある。最後の発言: $(said)" \
      "API の復旧（または設定）を確かめて autopilot start $name"
    return 1
  fi
  # A question is about this issue only; the next one won't hit the same wall. `taken` keeps it out of the next plan.
  if ! $closed && [[ $state == blocked ]] && (( elapsed >= MIN_JOB_SECONDS )); then
    echo "$(now) $kind $ref blocked on a question, skipping. answer: $(attach_hint "$w" "$id")"
    record "blocked $ref_line ($(attach_hint "$w" "$id"))"
    api_failures=0
    notify_hitl blocked "${label:0:80}$outcome" "worker（$w）が入力待ちで止まった（loop は次へ進んでいる）。最後の発言: $(said)" \
      "worker の問いに答える" "$(on_worker "$w" _w-rc "$id")"
    return 0
  fi
  if ! $closed && { [[ $state != done ]] || (( elapsed < MIN_JOB_SECONDS )); }; then
    end_loop "HALTED: $kind $ref ended in state $state after ${elapsed}s on $w (5h limit, error or a question?). Not launching more."
    echo "    see: claude logs $id on $w   answer: $(attach_hint "$w" "$id")   then: autopilot start $name"
    record "failed  $ref_line (state $state, $(attach_hint "$w" "$id"))"
    notify_hitl HALTED "${label:0:80}$outcome" "$w で state $state、$((elapsed / 60))m で終わり loop は止めた。最後の発言: $(said)" \
      "原因を見て、続けるなら autopilot start $name" "$(on_worker "$w" _w-rc "$id")"
    return 1
  fi
  # A finished session holds ~300MB while idle and nothing is left to answer in it; blocked/HALTED ones stay for attach.
  stop_job
  $closed || record "open    $ref_line"
  api_failures=0
  notify "[done] ${label:0:80}: $((elapsed / 60))m$outcome"
}

cmd_loop() {
  local name=$1 urgent_only=$2 deadline=$3 skill=$4 st dir
  FIVE_HOUR_MAX=$5 MODEL=${6:-}
  st=$(repo_state "$name"); dir=$(repo_dir "$name")
  touch "$st/taken" "$st/history"
  local api_failures=0 halted=false
  # Read once when the loop ends: the jobs run overnight, so one summary in the morning beats a notification per job.
  local digest; digest=$(mktemp)
  # Outcomes also go to history and the stop reason to last-exit, so `ls` and `watch` can tell what happened after the fact.
  record() { echo "$1" >>"$digest"; echo "$(date '+%F %H:%M') $1" >>"$st/history"; }
  end_loop() { echo "$(now) $1"; echo "$(date '+%F %H:%M') $1" >"$st/last-exit"; }
  # A job launched by an earlier loop (stopped, then started again) still counts as ours: run after it, not beside it,
  # and judge it like our own, or its outcome is lost and its idle session keeps its memory.
  if [[ -f $st/running ]]; then
    local prev_kind prev_ref prev_id prev_w prev_prompt prev_label prev_started
    read -r prev_kind prev_ref prev_id prev_w <"$st/running"
    prev_w=${prev_w:-$HOST}
    prev_started=$(stat -c %Y "$st/running")
    if [[ $prev_kind == prompt ]]; then
      prev_prompt=$(cat "$st/done/$prev_ref.prompt" 2>/dev/null); prev_label="$name ${prev_prompt%%$'\n'*}"
    else
      prev_prompt="$skill $prev_ref"; prev_label="$name#$prev_ref $(cd "$dir" && gh issue view "$prev_ref" --json title -q .title)"
    fi
    # Unreachable falls through to finish_job, which waits for the worker to answer.
    local prev_status="?" prev_listing
    prev_listing=$(agents "$prev_w") && prev_status=$(jq -r --arg id "$prev_id" '.[] | select(.id == $id) | .status' <<<"$prev_listing")
    # Gone between loops means someone stopped it by hand (claude stop, autopilot clean): nothing left to judge it by.
    if [[ -z $prev_status ]]; then
      echo "$(now) $prev_kind $prev_ref ($prev_id on $prev_w) from the previous loop is gone, not judging it"
      rm -f "$st/running"
    else
      [[ $prev_status == busy ]] && echo "$(now) waiting for $prev_kind $prev_ref ($prev_id on $prev_w) launched by the previous loop"
      finish_job "$prev_kind" "$prev_ref" "$prev_id" "$prev_label" "$prev_started" "$prev_prompt" "$prev_w" || halted=true
    fi
  fi
  while ! $halted; do
    if [[ -n "$deadline" ]] && (( $(date +%s) >= deadline )); then end_loop "deadline reached"; break; fi
    if [[ -f $st/paused ]]; then
      echo "$(now) paused"
      while [[ -f $st/paused ]]; do
        if [[ -n "$deadline" ]] && (( $(date +%s) >= deadline )); then end_loop "deadline reached"; break 2; fi
        sleep 30
      done
      echo "$(now) resumed"
      continue
    fi
    local line kind ref rest prompt label id
    line=$(plan "$name" "$urgent_only" | grep -a -m1 '^next ')
    [[ -n "$line" ]] || { end_loop "queue empty"; break; }
    read -r _ kind ref rest <<<"$line"
    if [[ $kind == prompt ]]; then
      prompt=$(cat "$st/queue/$ref.prompt"); label="$name ${prompt%%$'\n'*}"
    else
      prompt="$skill $ref"; label="$name#$ref ${rest#* }"
    fi
    local gate verdict until_epoch
    gate=$(usage_gate); read -r verdict until_epoch _ <<<"$gate"
    if [[ $verdict == halt ]]; then end_loop "HALTED: ${gate#halt }"; break; fi
    if [[ $verdict == wait ]]; then
      if [[ -n "$deadline" ]] && (( until_epoch >= deadline )); then end_loop "${gate#wait * }, resets after the deadline; stopping"; break; fi
      echo "$(now) waiting until $(date -d "@$until_epoch" +%H:%M): ${gate#wait * }"
      sleep $(( until_epoch - $(date +%s) + 60 ))
      continue
    fi
    local rc launched w
    while :; do
      launched=$(try_launch "$name" "$prompt" "${label:0:80}"); rc=$?
      (( rc == 0 )) && { read -r w id <<<"$launched"; break; }
      if (( rc == 2 )); then
        end_loop "HALTED: could not launch $kind $ref (see the launch error above). Not launching more."
        record "failed  ${label:0:80} (claude refused to launch)"
        notify_hitl HALTED "${label:0:80}" "claude が起動を拒否した（model ${MODEL:-default}）。loop は止めた。$(grep -a 'launch failed' "$st/log" | tail -1 | cut -c1-200)" \
          "原因（model・trust など）を直して autopilot start $name するか"
        break 2
      fi
      if [[ -n "$deadline" ]] && (( $(date +%s) >= deadline )); then end_loop "deadline reached"; break 2; fi
      sleep 60
    done
    if [[ $kind == prompt ]]; then mkdir -p "$st/done"; mv "$st/queue/$ref.prompt" "$st/done/"; else echo "$ref" >>"$st/taken"; sed -i "/^${ref}\$/d" "$st/resume" 2>/dev/null; fi
    echo "$kind $ref $id $w" >"$st/running"
    echo "$(now) $kind $ref launched as $id on $w"
    local issue; issue=$(job_issue "$kind" "$ref" "$prompt")
    notify "[start] ${label:0:80} ($id on $w)${issue:+$'\n'<$(cd "$dir" && gh issue view "$issue" --json url -q .url)>}"
    finish_job "$kind" "$ref" "$id" "$label" "$(date +%s)" "$prompt" "$w" || break
  done
  rm -f "$st/running" "$st/loop"
  sleep_idle_workers "$name"
  if [[ -s $digest ]]; then notify "[summary] $name"$'\n'"$(cat "$digest")"; fi
  rm -f "$digest"
}

cmd_start() {
  local name=${1:?usage: autopilot start <repo|all> [--urgent] [--until HH:MM] [--5h-max PCT] [--model sonnet]}; shift
  if [[ $name == all ]]; then
    local r; for r in $(project_names); do
      if tmux has-session -t "autopilot-$r" 2>/dev/null; then echo "autopilot-$r: already running"; else (cmd_start "$r" "$@"); fi
    done
    return
  fi
  name=${name##*/}
  local urgent_only=false until="" deadline="" skill=/issue-to-merge five_hour_max=$FIVE_HOUR_MAX model="" dir st
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --urgent) urgent_only=true; shift ;;
      --until) until=$2; shift 2 ;;
      --5h-max) five_hour_max=$2; shift 2 ;;
      --model) model=$2; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ $five_hour_max =~ ^[0-9]+$ ]] && (( five_hour_max >= 1 && five_hour_max <= 100 )) || die "--5h-max takes 1-100, got $five_hour_max"
  dir=$(repo_dir "$name"); st=$(repo_state "$name")
  tmux has-session -t "autopilot-$name" 2>/dev/null && die "already running for $name (autopilot stop $name first)"
  # Background sessions are interactive and refuse untrusted dirs.
  jq -e --arg p "$dir" '.projects[$p].hasTrustDialogAccepted' ~/.claude.json >/dev/null \
    || die "$dir is not trusted: run claude there once and accept"
  gh auth status >/dev/null 2>&1 || die "gh is not logged in"
  git -C ~/.claude pull --ff-only -q || echo "warning: ~/.claude pull failed, skills may be stale" >&2
  if [[ -n "$until" ]]; then
    deadline=$(date -d "$until" +%s) || die "bad --until: $until"
    (( deadline > $(date +%s) )) || deadline=$(date -d "tomorrow $until" +%s)
  fi
  echo "started $(now), until ${until:--}, 5h max ${five_hour_max}%, model ${model:-default}, urgent only $urgent_only, skill $skill" >"$st/loop"
  tmux new-session -d -s "autopilot-$name" \
    "$(printf '%q ' "$SELF" _loop "$name" "$urgent_only" "$deadline" "$skill" "$five_hour_max" "$model") >> $(printf %q "$st/log") 2>&1"
  echo "autopilot-$name: $(cat "$st/loop"). Log: $st/log"
}

cmd_stop() {
  local name=${1:?usage: autopilot stop <repo|all>}; name=${name##*/}
  if [[ $name == all ]]; then
    local r; for r in $(project_names); do tmux has-session -t "autopilot-$r" 2>/dev/null && (cmd_stop "$r"); done
    return 0
  fi
  tmux kill-session -t "autopilot-$name" || die "no loop running for $name"
  rm -f "$STATE/$name/loop"
  echo "$(date '+%F %H:%M') stopped by autopilot stop" >"$STATE/$name/last-exit"
  echo "stopped autopilot-$name (sessions it launched keep running; see autopilot status)"
}

cmd_pause() {
  local name=${1:?usage: autopilot pause <repo|all>} r
  [[ $name == all ]] && { for r in $(project_names); do (cmd_pause "$r"); done; return 0; }
  name=${name##*/}; repo_dir "$name" >/dev/null
  touch "$(repo_state "$name")/paused"
  echo "paused $name (the running job finishes; nothing new launches until autopilot resume $name)"
}

cmd_resume() {
  local name=${1:?usage: autopilot resume <repo|all>} r
  [[ $name == all ]] && { for r in $(project_names); do (cmd_resume "$r"); done; return 0; }
  name=${name##*/}; repo_dir "$name" >/dev/null
  rm -f "$(repo_state "$name")/paused"
  tmux has-session -t "autopilot-$name" 2>/dev/null && echo "resumed $name" || echo "resumed $name (no loop running; autopilot start $name)"
}

cmd_add() {
  local name=${1:?usage: autopilot add <repo> <issue#|prompt> [--urgent]} what=${2:?usage: autopilot add <repo> <issue#|prompt> [--urgent]}
  local dir st; dir=$(repo_dir "$name"); st=$(repo_state "$name")
  if [[ $what =~ ^#?[0-9]+$ ]]; then
    local labels=autopilot; [[ ${3:-} == --urgent ]] && labels+=,urgent
    # Launched issues are remembered across restarts so a job without its PR yet isn't launched twice; adding again means retry.
    sed -i "/^${what#\#}\$/d" "$st/taken"
    echo "${what#\#}" >>"$st/resume"
    (cd "$dir" && gh issue edit "${what#\#}" --add-label "$labels" --remove-label needs-answer) >/dev/null && echo "labeled #${what#\#}: $labels"
  else
    local id; id=$(date +%Y%m%d-%H%M%S)
    printf '%s\n' "$what" >"$st/queue/$id.prompt"
    echo "queued $id"
  fi
}

cmd_rm() {
  local name=${1:?usage: autopilot rm <repo> <issue#|prompt-id>} what=${2:?usage: autopilot rm <repo> <issue#|prompt-id>}
  local dir st; dir=$(repo_dir "$name"); st=$(repo_state "$name")
  if [[ $what =~ ^#?[0-9]+$ ]]; then
    (cd "$dir" && gh issue edit "${what#\#}" --remove-label autopilot --remove-label urgent) >/dev/null && echo "unlabeled #${what#\#}"
  else
    rm "$st/queue/$what.prompt" && echo "dropped $what"
  fi
}

cmd_ls() {
  local name st
  usage_line
  for name in $(project_names); do
    [[ -d $(project_path "$name")/.git ]] || { echo "== $name  not ready (autopilot projects)"; continue; }
    st=$(repo_state "$name")
    if tmux has-session -t "autopilot-$name" 2>/dev/null; then
      echo "== $name  loop: $([[ -f $st/paused ]] && echo "PAUSED, ")$(cat "$st/loop" 2>/dev/null)  last: $(tail -1 "$st/log" 2>/dev/null)"
    else
      echo "== $name  loop: stopped$([[ -f $st/paused ]] && echo " (paused: start will hold until resume)")  last: $(cat "$st/last-exit" 2>/dev/null || echo -)"
    fi
    if [[ -f $st/running ]]; then
      local kind ref id w; read -r kind ref id w <"$st/running"; w=${w:-$HOST}
      echo "  running  $kind $ref  $id on $w  $(agents "$w" 2>/dev/null | jq -r --arg id "$id" '.[] | select(.id == $id) | "\(.status)/\(.state)  \(.name)"')"
    fi
    plan "$name" | sed 's/^/  /'
  done
}

# Labels are checked on the controller (they live on GitHub); clone, trust and gh login on each worker that is awake.
cmd_projects() {
  local name dir problems labels w up=() p
  for w in $(worker_names); do on_worker "$w" _w-mem >/dev/null 2>&1 && up+=("$w") || echo "$w: unreachable (asleep?), not checked"; done
  for name in $(project_names); do
    dir=$(project_path "$name"); problems=()
    for w in "${up[@]}"; do
      p=$(on_worker "$w" _w-ready "$name" | paste -sd, -)
      [[ -n $p ]] && problems+=("$w: $p")
    done
    if [[ -d $dir/.git ]]; then
      labels=$(cd "$dir" && gh label list --limit 200 --json name -q '.[].name' 2>&1)
      grep -qx autopilot <<<"$labels" || problems+=("no autopilot label")
      grep -qx urgent <<<"$labels" || problems+=("no urgent label")
      grep -qx needs-answer <<<"$labels" || problems+=("no needs-answer label")
    fi
    if (( ${#problems[@]} )); then echo "$name  $dir  NOT READY: $(IFS=,; echo "${problems[*]}")"; else echo "$name  $dir  ready"; fi
  done
}

# Per worker; one that is asleep is reported, not woken.
for_each_worker() {
  local w out
  for w in $(worker_names); do
    if out=$(on_worker "$w" "$@" 2>/dev/null); then echo "== $w"; [[ -n $out ]] && echo "$out"
    else echo "== $w  unreachable (asleep?)"; fi
  done
}
cmd_status() { for_each_worker _w-status; }
cmd_clean() { for_each_worker _w-clean; sleep_idle_workers; }

cmd_res() {
  local mt ma sw
  read -r _ mt _ <<<"$(free -g | grep Mem)"; ma=$(free -g | awk '/Mem/{print $7}'); sw=$(free -g | awk '/Swap/{print $3}')
  # Bracketed patterns keep pgrep from matching this probe itself.
  printf '%s  load %s/%s  mem avail %sG/%sG  swap %sG  claude %s  heavy(tsc/vitest) %s\n' \
    "$(hostname -s)" "$(cut -d' ' -f1 /proc/loadavg)" "$(nproc)" "$ma" "$mt" "$sw" \
    "$(pgrep -cx claude)" "$(pgrep -cf '[t]sc |[v]itest')"
}

cmd=${1:-}; shift || true
case "$cmd" in
  ls) cmd_ls ;;
  add) cmd_add "$@" ;;
  rm) cmd_rm "$@" ;;
  start) cmd_start "$@" ;;
  stop) cmd_stop "$@" ;;
  pause) cmd_pause "$@" ;;
  resume) cmd_resume "$@" ;;
  watch) cmd_watch "$@" ;;
  _watch-tick) cmd_watch_tick "$@" ;;
  _escalate) cmd_escalate "$@" ;;
  _api-retry-wait) api_retry_wait "$@" ;;
  projects) cmd_projects ;;
  status) cmd_status ;;
  clean) cmd_clean ;;
  res) for_each_worker _w-res ;;
  _w-agents) claude agents --json ;;
  _w-mem) awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo ;;
  _w-ready) cmd_w_ready "$@" ;;
  _w-launch) cmd_w_launch "$@" ;;
  _w-stop) claude stop "$1" ;;
  _w-rc) rc_url "$1" ;;
  _w-said) cmd_w_said "$1" ;;
  _w-limits) cmd_w_limits ;;
  _w-status) cmd_w_status ;;
  _w-clean) cmd_w_clean ;;
  _w-res) cmd_res ;;
  _w-suspend) cmd_w_suspend ;;
  _loop) cmd_loop "$@" ;;
  _last-said) last_said "$1" ;;
  *) sed -n '2,19p' "$SELF" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
