#!/usr/bin/env bash
# Human-in-the-loop notifications: post to the Discord #hitl channel only when the user has to act.
# (The autopilot webhook is a log stream nobody watches; this channel stays quiet unless something waits on a human.)
#   hitl send <text>   post one message
#   hitl scan          notify issues/PRs that newly got the needs-answer label, across the projects in autopilot's projects.conf
# Runs on the worker host (vaio); off it, it forwards itself over ssh. scan runs from hitl-scan.timer every 5 minutes.
# Webhook URL: ~/.config/notify/hitl-webhook on vaio (outside git, chmod 600: anyone holding it can post).
# Without it nothing is sent and nothing is marked notified, so pending items go out once the file exists.
set -uo pipefail

HOST=vaio
if [[ "$(hostname)" != ${HOST}* ]]; then
  exec ssh "$HOST" "bash -lc $(printf %q "$(printf '%q ' "$HOME/.claude/bin/hitl" "$@")")"
fi

WEBHOOK_FILE=$HOME/.config/notify/hitl-webhook
PROJECTS_CONF=$HOME/.claude/skills/autopilot/projects.conf
STATE=$HOME/.local/state/hitl
NOTIFIED=$STATE/notified
LABEL=${HITL_LABEL:-needs-answer}  # override only to test scan against an existing label without touching any issue
mkdir -p "$STATE"
touch "$NOTIFIED"

log() { echo "$(date '+%F %T') $*" >> "$STATE/log"; }

cmd_send() {
  local text=$1
  if [[ ! -s $WEBHOOK_FILE ]]; then
    log "no webhook ($WEBHOOK_FILE); not sent: ${text%%$'\n'*}"
    return 1
  fi
  jq -n --arg c "$text" '{content: $c}' \
    | curl -fsS -m 10 -H 'Content-Type: application/json' -d @- "$(cat "$WEBHOOK_FILE")" >/dev/null \
    || { log "send failed: ${text%%$'\n'*}"; return 1; }
}

cmd_scan() {
  local name dir slug n title url ev evid evat comment key
  while read -r name dir; do
    dir=${dir/#\~/$HOME}
    [[ -d $dir/.git ]] || continue
    slug=$(cd "$dir" && gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) || { log "gh repo view failed in $dir"; continue; }
    while IFS=$'\t' read -r n title url; do
      [[ -n $n ]] || continue
      # Keyed on the labeling event, so removing and re-adding the label notifies again.
      ev=$(gh api --paginate "repos/$slug/issues/$n/events?per_page=100" \
        | jq -r --arg l "$LABEL" '.[] | select(.event == "labeled" and .label.name == $l) | "\(.id) \(.created_at)"' | tail -1)
      [[ -n $ev ]] || continue
      read -r evid evat <<< "$ev"
      key="$slug#$n:$evid"
      grep -qxF "$key" "$NOTIFIED" && continue
      comment=$(gh api --paginate "repos/$slug/issues/$n/comments?per_page=100" \
        | jq -r --arg t "$evat" '.[] | select(.created_at <= $t) | .html_url' | tail -1)
      if cmd_send "[$LABEL] ${slug#*/}#$n ${title:0:100}"$'\n'"<${comment:-$url}>"$'\n'"Claude に任せるなら Remote Control の vaio-ops で「${slug#*/}#$n を見て」"; then
        echo "$key" >> "$NOTIFIED"
        log "notified $key"
      fi
    done < <(gh api "repos/$slug/issues?labels=$LABEL&state=open&per_page=100" --jq '.[] | [.number, .title, .html_url] | @tsv' 2>/dev/null)
  done < <(grep -v '^\s*#' "$PROJECTS_CONF" | awk 'NF {print $1, $2}')
}

case ${1:-} in
  send) shift; [[ $# -gt 0 ]] || { echo "usage: hitl send <text>" >&2; exit 1; }; cmd_send "$*" ;;
  scan) cmd_scan ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
