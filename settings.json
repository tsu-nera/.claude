{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Slack__slack_send_message"
    ],
    "ask": [
      "mcp__claude_ai_Gmail__trash_message",
      "mcp__claude_ai_Gmail__trash_thread",
      "mcp__plugin_todoist_todoist__delete-object",
      "Bash(td task delete:*)",
      "Bash(td project delete:*)",
      "Bash(td project archive:*)",
      "Bash(td section delete:*)",
      "Bash(td comment delete:*)",
      "Bash(td label delete:*)",
      "Bash(td filter delete:*)",
      "Bash(td reminder delete:*)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "post-plan-to-issue": "off",
    "update-issue": "off"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/capture-message.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-file-size.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-raw-gh-issue-create.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/require-merge-gate.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/projects/.sync/memory-sync hook",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ -d ~/repo/agent-private ] || exit 0; MEMORY_SYNC_ROOT=~/repo/agent-private timeout 20 ~/.claude/projects/.sync/memory-sync sync",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "todoist@doist": true
  },
  "extraKnownMarketplaces": {
    "doist": {
      "source": {
        "source": "github",
        "repo": "doist/todoist-mcp"
      }
    }
  },
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754039946567
  },
  "autoUpdates": true,
  "tui": "fullscreen"
}
